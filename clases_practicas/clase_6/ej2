class Contenido:
    conteo_total = 0
    def __init__(self, titulo, year):
        self.titulo = titulo
        self.year = year

    @classmethod
    def obtener_total(cls):
        return cls.conteo_total

class Pelicula(Contenido):
    def __init__(self, titulo, year, director , duracion):
        super().__init__(titulo, year)
        Contenido.conteo_total += 1
        self.director = director
        self.duracion = duracion

    def mostrar_ficha(self):

        print("----------------------- Atributos de Película -------------------------")
        print("Título: ", self.titulo)
        print("Año de estreno: ", self.year)
        print("Director: ", self.director)
        print("Duración: ", self.duracion)
        print("-----------------------------------------------------------------------")

