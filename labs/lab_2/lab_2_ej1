# Ejercicio 1
def auditar_red():
    print("------------- Auditoría de Red ESP8266 ---------------")
    n_nodos = 0
    ip_falla = []
    total_dac = 0
    n_nodos_act = 0
    for i, data in red_esp8266.items():
        n_nodos += 1
        if (data["estado"] == "falla")  or (data["estado"] == "inactivo"):
            ip_falla.append(data["ip"])
        elif (data["estado"] == "activo"):
            total_dac = data["salida_dac"] + total_dac
            n_nodos_act += 1
    dac_mean = total_dac/n_nodos_act
    print("Nodos registrados: ",n_nodos)
    print("")
    print("IP's de nodos inactivos/falla: ", ip_falla)
    print("")
    print("Promedio salida DAC en nodos activos: ",dac_mean)
    print ("---------------------------------------------------")
    # -------------------

